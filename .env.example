# ---------------------------------------------------------------------------
# MSST API configuration (copy to .env and adjust)
# ---------------------------------------------------------------------------

# Where downloaded checkpoints and configs are stored.
MSST_MODEL_DIR=/models

# RVC voice conversion. Voice models (flat *.pth + optional *.index) are read
# from here; auxiliary embedder/F0 assets are cached in the asset dir. Both
# default to subdirectories of MSST_MODEL_DIR.
# MSST_RVC_MODEL_DIR=/models/rvc_models
# MSST_RVC_ASSET_DIR=/models/rvc_assets
# Default RVC feature extractor: contentvec | spin | spin-v2 | chinese-hubert-base
# MSST_RVC_EMBEDDER=contentvec

# ASR (single-sentence `asr` + streaming `streaming_asr`). Model bundles live
# under MSST_ASR_MODEL_DIR (default <MSST_MODEL_DIR>/asr). Qwen3-ASR is
# downloaded from the Hub and PinyinASR/RomajiASR from their GitHub release
# assets on first use; bundles can also be placed there directly or fetched via
# a custom catalog (MSST_ASR_CATALOG).
# MSST_ASR_MODEL_DIR=/models/asr
# MSST_ASR_DEFAULT_MODEL=qwen3-asr-1.7b
# Streaming backend: auto (vLLM if installed, else chunked transformers) | vllm | transformers
# MSST_ASR_STREAMING_BACKEND=auto
# MSST_ASR_CATALOG=/path/to/asr_catalog.json

# Vocal2Midi (v2m): GAME / TiFA / HubertFA / RMVPE / kashi-g2p ONNX bundles.
# Defaults to <MSST_MODEL_DIR>/v2m. All are prepared on first use:
# GAME/HubertFA/kashi-g2p from their GitHub release archives, and TiFA exported
# from openvpi's PyTorch release via the vendored TIFA deploy code.
# RMVPE reuses the RVC/Applio predictor (no separate download).
# MSST_V2M_MODEL_DIR=/models/v2m
# MSST_V2M_CATALOG=/path/to/v2m_catalog.json
# Pitch-curve backend: rvc (reuse the RVC/Applio RMVPE; default) | onnx
# MSST_V2M_RMVPE_BACKEND=rvc
# TiFA ONNX export opset (18-20) and whether to keep the PyTorch checkpoint.
# MSST_V2M_TIFA_OPSET=18
# MSST_V2M_TIFA_KEEP_SOURCE=false
# Hard cap (seconds) on each GAME chunk; bounds the estimator VRAM. 0 disables.
MSST_V2M_MAX_CHUNK_SEC=30
# When a request omits `language` (or passes `auto`), Qwen3-ASR samples this many
# seconds to auto-detect zh/en/ja/yue. Fallback language + sample window:
MSST_V2M_LANGUAGE_DETECT_SEC=30
MSST_V2M_DEFAULT_LANGUAGE=zh

# DiffSinger singing voice synthesis (SVS). OpenUtau-compatible voicebank
# folders (dsconfig.yaml + aco/dsdur/dspitch/dsvariance/dsvocoder) live under
# MSST_SVS_MODEL_DIR (default <MSST_MODEL_DIR>/svs). Endpoints:
#   POST /api/diffsinger/inference   (ustx -> wav; ustx + generated pitd)
#   POST /api/diffsinger/pitch       (ustx -> ustx with a generated pitd curve)
#   GET  /api/diffsinger/models
# MSST_SVS_MODEL_DIR=/models/svs
# Voicebank used when a request omits `model`.
# MSST_SVS_DEFAULT_MODEL=

# HTTP server.
MSST_HOST=0.0.0.0
MSST_PORT=8000

# Default inference device. GPU-only unless MSST_ALLOW_CPU=true.
MSST_DEVICE=cuda:0
MSST_ALLOW_CPU=false

# Model instances kept in GPU memory (LRU) and concurrent requests.
MSST_MAX_LOADED_MODELS=1
MSST_MAX_CONCURRENCY=1

# Upload / temp handling.
MSST_MAX_UPLOAD_MB=512
MSST_TEMP_DIR=/tmp/msst-api
MSST_KEEP_TEMP=false

# Download backend preference: modelscope (default) | huggingface | auto.
MSST_DOWNLOAD_BACKEND=modelscope
# Optional ModelScope repo that mirrors the HF "All_Models" layout. When the
# official MSST weights are not present on ModelScope, set this to a mirror
# you control to make ModelScope the effective download source.
# MSST_MODELSCOPE_MIRROR=your-org/MSST-WebUI
# Fail instead of falling back to another backend.
MSST_STRICT_BACKEND=false
# Optional Hugging Face mirror, e.g. https://hf-mirror.com
# MSST_HF_ENDPOINT=https://hf-mirror.com
# Prefix proxy for GitHub downloads (release assets). GitHub URLs are fetched
# as <proxy><url>, e.g. https://ghfast.top/https://github.com/... Set empty to
# download from GitHub directly.
MSST_GITHUB_PROXY=https://ghfast.top/
# MSST_HF_TOKEN=
# MSST_MODELSCOPE_TOKEN=
# Verify sha256 after download.
MSST_VERIFY_DOWNLOAD=true
# Per-read timeout (seconds) for downloads; 0 disables it.
MSST_DOWNLOAD_TIMEOUT=60
# Optional: disable Hugging Face Xet transport if downloads stall.
# HF_HUB_DISABLE_XET=1
