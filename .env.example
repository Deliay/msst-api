# ---------------------------------------------------------------------------
# MSST API configuration (copy to .env and adjust)
# ---------------------------------------------------------------------------

# Where downloaded checkpoints and configs are stored.
MSST_MODEL_DIR=/models

# RVC voice conversion. Voice models (flat *.pth + optional *.index) are read
# from here; auxiliary embedder/F0 assets are cached in the asset dir. Both
# default to subdirectories of MSST_MODEL_DIR.
# MSST_RVC_MODEL_DIR=/models/rvc_models
# MSST_RVC_ASSET_DIR=/models/rvc_assets
# Default RVC feature extractor: contentvec | spin | spin-v2 | chinese-hubert-base
# MSST_RVC_EMBEDDER=contentvec

# HTTP server.
MSST_HOST=0.0.0.0
MSST_PORT=8000

# Default inference device. GPU-only unless MSST_ALLOW_CPU=true.
MSST_DEVICE=cuda:0
MSST_ALLOW_CPU=false

# Model instances kept in GPU memory (LRU) and concurrent requests.
MSST_MAX_LOADED_MODELS=1
MSST_MAX_CONCURRENCY=1

# Upload / temp handling.
MSST_MAX_UPLOAD_MB=512
MSST_TEMP_DIR=/tmp/msst-api
MSST_KEEP_TEMP=false

# Download backend preference: modelscope (default) | huggingface | auto.
MSST_DOWNLOAD_BACKEND=modelscope
# Optional ModelScope repo that mirrors the HF "All_Models" layout. When the
# official MSST weights are not present on ModelScope, set this to a mirror
# you control to make ModelScope the effective download source.
# MSST_MODELSCOPE_MIRROR=your-org/MSST-WebUI
# Fail instead of falling back to another backend.
MSST_STRICT_BACKEND=false
# Optional Hugging Face mirror, e.g. https://hf-mirror.com
# MSST_HF_ENDPOINT=https://hf-mirror.com
# MSST_HF_TOKEN=
# MSST_MODELSCOPE_TOKEN=
# Verify sha256 after download.
MSST_VERIFY_DOWNLOAD=true
# Per-read timeout (seconds) for downloads; 0 disables it.
MSST_DOWNLOAD_TIMEOUT=60
# Optional: disable Hugging Face Xet transport if downloads stall.
# HF_HUB_DISABLE_XET=1
